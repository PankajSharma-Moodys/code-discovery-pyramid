{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdp.dev/schema/help/1.0.0",
  "title": "CDP command surface",
  "description": "The machine-readable output of `cdp help --json` (CDP_CLI_SCOPE.md §C item 1.4). A LangGraph/ADK/MCP front-end discovers the command set from this document rather than from a hand-written adapter, which is why it is committed and versioned rather than being whatever the renderer happened to print. `commands[]` is derived from the live argparse tree in `cli._parser`, never hand-maintained; tests/test_help.py asserts that every subparser appears here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cdp_version", "prog", "commands", "workflows", "guidance"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "cdp_version": { "type": "string" },
    "prog": { "type": "string" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workflow" }
    },
    "guidance": {
      "type": "object",
      "description": "Ordered prose sections: heading -> lines. Guidance, not flags — when to use what, in what order, what comes next.",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "usage", "options"],
      "properties": {
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "usage": { "type": "string" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "flags", "positional", "required", "help"],
      "properties": {
        "name": { "type": "string" },
        "flags": { "type": "array", "items": { "type": "string" } },
        "positional": { "type": "boolean" },
        "required": { "type": "boolean" },
        "help": { "type": "string" },
        "choices": { "type": "array", "items": { "type": "string" } },
        "default": { "type": ["string", "number", "boolean"] }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "when", "steps", "why"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "when": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "why": { "type": "string" }
      }
    }
  }
}
