{
  "policy": {"max_line_bytes": 1000, "retry": {"javascript": "tsx"}, "timeout_s": 60,
             "vendor_dirs": ["node_modules", "vendor", "third_party", "bower_components", "dist", "build", ".yarn"],
             "vendor_files": ["\\.min\\.(js|css)$", "\\.bundle\\.js$", "-lock\\.json$"],
             "generated_markers": ["@generated", "code generated", "do not edit", "auto-generated", "autogenerated"],
             "generated_head_lines": 5},
  "grammars": {
    "java": {"module": "tree_sitter_java", "fn": "language", "ext": [".java"]},
    "csharp": {"module": "tree_sitter_c_sharp", "fn": "language", "ext": [".cs"]},
    "scala": {"module": "tree_sitter_scala", "fn": "language", "ext": [".scala", ".sc"]},
    "python": {"module": "tree_sitter_python", "fn": "language", "ext": [".py", ".pyi"]},
    "typescript": {"module": "tree_sitter_typescript", "fn": "language_typescript", "ext": [".ts", ".mts", ".cts"]},
    "tsx": {"module": "tree_sitter_typescript", "fn": "language_tsx", "ext": [".tsx"]},
    "javascript": {"module": "tree_sitter_javascript", "fn": "language", "ext": [".js", ".jsx", ".mjs", ".cjs"]},
    "ruby": {"module": "tree_sitter_ruby", "fn": "language", "ext": [".rb"], "baseline_only": true}
  }
}
