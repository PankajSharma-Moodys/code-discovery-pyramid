{
  "family": "spring_web",
  "language": "java",
  "rules": [
    {
      "id": "spring.web.mapping",
      "match": {
        "fqn": [
          "org.springframework.web.bind.annotation.GetMapping",
          "org.springframework.web.bind.annotation.PostMapping",
          "org.springframework.web.bind.annotation.PutMapping",
          "org.springframework.web.bind.annotation.DeleteMapping",
          "org.springframework.web.bind.annotation.PatchMapping",
          "org.springframework.web.bind.annotation.RequestMapping"
        ],
        "on": "method"
      },
      "aliases": ["GetMapping", "PostMapping", "PutMapping", "DeleteMapping", "PatchMapping", "RequestMapping"],
      "vars": {"verb": {"GetMapping": "GET", "PostMapping": "POST", "PutMapping": "PUT", "DeleteMapping": "DELETE",
                        "PatchMapping": "PATCH", "RequestMapping": "ANY"}},
      "unless": {"owner": {"fqn": ["org.springframework.cloud.openfeign.FeignClient",
                                   "org.springframework.cloud.netflix.feign.FeignClient"],
                           "aliases": ["FeignClient"]},
                 "imports": ["retrofit2.http"]},
      "emit": {
        "channel": "http_in",
        "signal": "http_resource",
        "target": "route:{vars.verb} {join(owner.Path.value|owner.RequestMapping.value|owner.RequestMapping.path, value|path|decl.Path.value)}"
      }
    },
    {
      "id": "spring.web.class",
      "match": {"fqn": "org.springframework.web.bind.annotation.RequestMapping", "on": "class"},
      "aliases": ["RequestMapping"],
      "fallback": true,
      "when": {"first_type": true},
      "unless": {"owner": {"fqn": ["org.springframework.cloud.openfeign.FeignClient",
                                   "org.springframework.cloud.netflix.feign.FeignClient"],
                           "aliases": ["FeignClient"]},
                 "imports": ["retrofit2.http"]},
      "emit": {"channel": "http_in", "signal": "http_resource", "target": "route:{value|path}"}
    }
  ]
}
